# AI LifeDesk Environment Configuration

# Database: Default SQLite for zero-setup running. For PostgreSQL, set to postgresql://user:password@localhost:5432/lifedesk
DATABASE_URL="file:./dev.db"

# Authentication secret for JWT session tokens
AUTH_SECRET="your-super-secret-auth-key-change-in-production"

# Google Gemini API Key (Backend-only, never exposed to client)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Optional settings
NEXT_PUBLIC_APP_NAME="AI LifeDesk"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
